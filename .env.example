# Optional image CLI adapter. It must write a real PNG to {output}.
JIMENG_IMAGE_CLI=/absolute/path/to/your-image-cli
JIMENG_IMAGE_ARGS_JSON=["--prompt-file","{prompt_file}","--output","{output}","--asset-type","{asset_type}"]

# Optional video CLI adapter. It must write a real MP4 to {output}.
JIMENG_VIDEO_CLI=/absolute/path/to/your-video-cli
JIMENG_VIDEO_ARGS_JSON=["--prompt-file","{prompt_file}","--references-file","{references_file}","--duration","{duration_sec}","--ratio","{aspect_ratio}","--model","{model_version}","--session","{session_id}","--output","{output}"]
JIMENG_VIDEO_RESOLUTION=720p
JIMENG_VIDEO_POLL_SEC=600
