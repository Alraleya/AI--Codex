{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Manga Workbench Stage Text Output",
  "type": "object",
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "content": { "type": "string", "minLength": 1 }
            },
            "required": ["path", "content"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "size": { "type": "integer", "minimum": 1 },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": ["path", "size", "sha256"],
            "additionalProperties": false
          }
        ]
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "reason": { "type": "string" },
        "issues": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["passed", "reason"],
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200,
      "description": "给下一节点的短交接摘要，只写关键决定、连续性锁定和未决风险，不复制产物全文。"
    },
    "shot_plan": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "state": { "type": "string", "const": "resolved" },
            "shot_count": { "type": "integer", "minimum": 1, "maximum": 30 },
            "durations_sec": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "items": { "type": "number", "minimum": 3, "maximum": 15 }
            },
            "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
          },
          "required": ["state", "shot_count", "durations_sec", "reason"],
          "additionalProperties": false
        }
      ]
    },
    "storyboard_plan": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "state": { "type": "string", "const": "resolved" },
            "shots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "items": {
                "type": "object",
                "properties": {
                  "shot_number": { "type": "integer", "minimum": 1, "maximum": 30 },
                  "columns": { "type": "integer", "minimum": 2, "maximum": 4 },
                  "rows": { "type": "integer", "minimum": 2, "maximum": 4 },
                  "panel_count": { "type": "integer", "minimum": 4, "maximum": 12 },
                  "timepoints_sec": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 12,
                    "items": { "type": "number", "minimum": 0 }
                  },
                  "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
                },
                "required": [
                  "shot_number",
                  "columns",
                  "rows",
                  "panel_count",
                  "timepoints_sec",
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": ["state", "shots"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["files", "review", "summary", "shot_plan", "storyboard_plan"],
  "additionalProperties": false
}
